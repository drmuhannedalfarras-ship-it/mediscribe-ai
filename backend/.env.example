# Application
NODE_ENV=development
PORT=3001

# Database (matches docker-compose's exposed postgres port/credentials)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mediscribe_user
DB_PASSWORD=secure_password_change_me
DB_NAME=mediscribe
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# Redis (provisioned via docker-compose; not yet consumed by the app)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_change_me
REDIS_DB=0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=86400

# CORS - must match the URL the frontend is served on
CORS_ORIGIN=http://localhost:4201

# File uploads
FILE_UPLOAD_DIRECTORY=./uploads
