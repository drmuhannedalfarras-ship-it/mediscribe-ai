# Application
NODE_ENV=development
APP_PORT=3000
APP_NAME=MediScribe AI
APP_VERSION=0.1.0

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=86400
SESSION_SECRET=your-session-secret-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-min
ENCRYPTION_IV=your-encryption-iv-16-chars

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mediscribe
DB_PASSWORD=password-change-in-production
DB_DATABASE=mediscribe_ai
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Services
AI_PROVIDER=anthropic
AI_API_KEY=your-api-key-here
AI_MODEL=claude-3-sonnet-20240229
SPEECH_TO_TEXT_PROVIDER=azure
SPEECH_TO_TEXT_KEY=your-key-here
SPEECH_TO_TEXT_REGION=eastus

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=14

# Security Headers
CORS_ORIGIN=http://localhost:4200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage
FILE_UPLOAD_DIRECTORY=./uploads
FILE_MAX_SIZE=52428800
AUDIO_RETENTION_DAYS=90

# Email (Future)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Audit
AUDIT_ENABLED=true
AUDIT_LOG_PATH=./logs/audit

# Feature Flags
FEATURE_AUDIO_RECORDING=true
FEATURE_SPEAKER_DIARIZATION=true
FEATURE_CLINICAL_EXTRACTION=true
FEATURE_AI_GENERATION=true
