# =============================================================================
# MediScribe AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update values for your local environment
# DO NOT commit .env file to version control
# =============================================================================

# Node Environment
NODE_ENV=development

# Backend Configuration
BACKEND_PORT=3000
LOG_LEVEL=debug

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mediscribe
DB_USER=mediscribe_user
DB_PASSWORD=secure_password_change_me
DB_SSL=false
DB_LOGGING=true

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_change_me
REDIS_DB=0

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRATION=86400
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true

# Frontend Configuration
FRONTEND_PORT=4200
API_URL=http://localhost:3000
WS_URL=ws://localhost:3000

# pgAdmin Configuration
PGADMIN_EMAIL=admin@mediscribe.local
PGADMIN_PASSWORD=admin_change_me
PGADMIN_PORT=5050

# Redis Commander Configuration
REDIS_COMMANDER_PORT=8081

# Application Configuration
APP_NAME=MediScribe AI
APP_VERSION=1.0.0
APP_DESCRIPTION=Clinical AI Copilot Platform

# Audio Configuration
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=2
AUDIO_BIT_DEPTH=16
MAX_AUDIO_FILE_SIZE=500000000
AUDIO_RETENTION_DAYS=30

# Transcription Configuration
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_CONFIDENCE_THRESHOLD=0.8
SUPPORTED_LANGUAGES=en,ar,es,fr

# Consent Configuration
CONSENT_TYPES=recording,transcription,data-sharing
CONSENT_EXPIRATION_DAYS=365

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=1000000000
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,wav,mp3,m4a

# Email Configuration (Optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@mediscribe.local
EMAIL_PASSWORD=change_me
EMAIL_FROM=MediScribe <noreply@mediscribe.local>

# Logging Configuration
LOG_FORMAT=json
LOG_DIR=/app/logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=10M

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true
HELMET_CONTENT_SECURITY_POLICY=true

# Feature Flags
FEATURE_AUDIO_RECORDING=true
FEATURE_TRANSCRIPTION=true
FEATURE_AI_ANALYSIS=true
FEATURE_CONSENT_MANAGEMENT=true
FEATURE_AUDIT_LOGGING=true

# =============================================================================
# DO NOT MODIFY BELOW UNLESS YOU KNOW WHAT YOU'RE DOING
# =============================================================================
